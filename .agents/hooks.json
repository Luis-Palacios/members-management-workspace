{
  "branch-name": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/branch-name.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "session-status": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./hooks/session-status.mjs",
        "timeout": 10
      }
    ]
  }
}
