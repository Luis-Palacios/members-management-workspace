# Umbrella repo: tracks only the shared workspace files. Each service below is its own git repo.
/*
!/.gitignore
!/.agents/
!/AGENTS.md
!/CLAUDE.md
!/GEMINI.md
!/README.md
!/docs/
!/.claude/
/.claude/settings.local.json

# macOS Finder metadata, anywhere in the tree
.DS_Store

# Private keys, anywhere in the tree (gh-as-bot also looks for one inside .agents/)
*.pem
